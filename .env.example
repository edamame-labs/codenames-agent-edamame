# Copy this file to .env for local tooling, or export the variable directly.
# Never commit a real credential.
OPENAI_API_KEY=

# Optional model overrides used by the preserved v0 agents.
EDAMAME_CM_MODEL=gpt-5.6-sol
EDAMAME_CM_REASONING=high
EDAMAME_G_MODEL=gpt-5.6-sol
EDAMAME_G_REASONING=high
V0_BACKUP_MODEL=gpt-5.6-terra
V0_BACKUP_REASONING=none

# ClueCast online game (Vercel / local api/). Production needs a unique secret.
CLUECAST_APP_SECRET=
CLUECAST_OPENROUTER_API_KEY=
CLUECAST_OPENROUTER_MODEL=openai/gpt-5.6-terra
CLUECAST_SIMULATOR_MODEL=openai/gpt-5.6-luna
CLUECAST_HINT_MODEL=openai/gpt-5.6-luna
CLUECAST_OPENROUTER_REFERER=
CLUECAST_OPENROUTER_TITLE=ClueCast

# Problem reports: private Blob log + Resend notification.
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
CLUECAST_REPORT_TO=
CLUECAST_REPORT_FROM="ClueCast Reports <reports@edamamelabs.com>"
